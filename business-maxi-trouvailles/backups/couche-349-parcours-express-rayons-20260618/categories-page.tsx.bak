import type { Metadata } from "next";
import Link from "next/link";
import { ArrowRight, BadgeEuro, Headphones, ShieldCheck, Truck } from "lucide-react";
import { CategoryGrid } from "@/components/CategoryGrid";
import { PageHeader } from "@/components/PageHeader";
import { PartnerArticlePreviewPanel } from "@/components/PartnerArticlePreviewPanel";
import {
  buildPartnerDemoCategoryCards,
  PartnerDemoPathPanel,
} from "@/components/PartnerDemoPathPanel";
import { PartnerMobileShowcasePanel } from "@/components/PartnerMobileShowcasePanel";
import {
  categories,
  isDropshippingCategory,
  isDropshippingProduct,
} from "@/lib/catalog";
import { getAllProducts, getPublicProducts } from "@/lib/catalog-server";

export const dynamic = "force-dynamic";

export const metadata: Metadata = {
  title: "Catégories produits partenaires",
  description: "Catégories produits partenaires préparées pour Maxi Trouvaille.",
};

export default async function CategoriesPage() {
  const [publicProducts, catalogProducts] = await Promise.all([
    getPublicProducts(),
    getAllProducts(),
  ]);
  const partnerCandidateCount = catalogProducts.filter(isDropshippingProduct).length;
  const partnerCategoryCount = categories.filter(isDropshippingCategory).length;
  const publicPartnerCount = publicProducts.filter(isDropshippingProduct).length;
  const demoCategoryCards = buildPartnerDemoCategoryCards({
    catalogProducts,
    publicProducts,
  });

  return (
    <>
      <PageHeader
        eyebrow="Catégories partenaires"
        title="Rayons produits partenaires"
        description="Nouveautés, promotions, maison, cuisine, beauté, high-tech, auto-moto et autres rayons utiles pour le catalogue partenaires."
      />
      <section className="container-page py-10">
        <div className="mb-8 grid gap-3 rounded-lg border border-line bg-paper p-4 shadow-sm md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <p className="flex items-center gap-2 text-sm font-black uppercase text-teal">
              <ShieldCheck size={16} aria-hidden="true" />
              Vitrine de lancement
            </p>
            <h2 className="mt-2 text-2xl font-black">
              Les rayons sont visibles, le paiement reste encadré.
            </h2>
            <p className="mt-2 max-w-3xl text-sm leading-6 text-muted">
              Chaque rayon peut être présenté sur téléphone avec paiement Maxi
              Trouvaille, suivi colis et validation humaine avant publication
              d&apos;une fiche produit.
            </p>
          </div>
          <div className="flex flex-col gap-3 sm:flex-row md:justify-end">
            <Link
              href="/boutique"
              className="focus-ring inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-foreground px-4 text-sm font-black text-white hover:bg-[#2b2b2b]"
            >
              Voir la boutique
              <ArrowRight size={17} aria-hidden="true" />
            </Link>
            <Link
              href="/contact"
              className="focus-ring inline-flex min-h-11 items-center justify-center gap-2 rounded-md border border-line bg-white px-4 text-sm font-black hover:bg-[#f1eadf]"
            >
              <Headphones size={17} aria-hidden="true" />
              Service client
            </Link>
          </div>
        </div>
        <PartnerMobileShowcasePanel
          className="mb-8"
          publicProductCount={publicPartnerCount}
          partnerCandidateCount={partnerCandidateCount}
          categoryCount={partnerCategoryCount}
        />
        <PartnerDemoPathPanel
          className="mb-8"
          cards={demoCategoryCards}
          candidateCount={partnerCandidateCount}
          publicProductCount={publicPartnerCount}
        />
        <CategoryGrid />
        <PartnerArticlePreviewPanel className="mt-8" />
        <div className="mt-8 grid gap-3 md:grid-cols-3">
          <div className="rounded-lg border border-line bg-paper p-4 shadow-sm">
            <BadgeEuro className="text-teal" size={22} aria-hidden="true" />
            <h2 className="mt-3 text-base font-black">Prix clairs</h2>
            <p className="mt-2 text-sm leading-6 text-muted">
              Prix et conditions de vente sont vérifiés avant publication
              publique.
            </p>
          </div>
          <div className="rounded-lg border border-line bg-paper p-4 shadow-sm">
            <Truck className="text-teal" size={22} aria-hidden="true" />
            <h2 className="mt-3 text-base font-black">Livraison suivie</h2>
            <p className="mt-2 text-sm leading-6 text-muted">
              Le client retrouve le suivi colis depuis l&apos;espace Maxi Trouvaille.
            </p>
          </div>
          <div className="rounded-lg border border-line bg-paper p-4 shadow-sm">
            <ShieldCheck className="text-teal" size={22} aria-hidden="true" />
            <h2 className="mt-3 text-base font-black">Photos exactes</h2>
            <p className="mt-2 text-sm leading-6 text-muted">
              Aucune fiche produit n&apos;est publiée sans visuel exact validé.
            </p>
          </div>
        </div>
      </section>
    </>
  );
}
