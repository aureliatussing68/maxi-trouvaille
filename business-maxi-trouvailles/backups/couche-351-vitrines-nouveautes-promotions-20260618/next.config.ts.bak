import type { NextConfig } from "next";

const publicRouteAliases = [
  { source: "/aide", destination: "/faq", permanent: true },
  { source: "/catalogue", destination: "/boutique", permanent: true },
  {
    source: "/cgv",
    destination: "/conditions-generales-vente",
