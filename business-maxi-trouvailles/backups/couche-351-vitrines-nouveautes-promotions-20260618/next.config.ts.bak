  async redirects() {
    return [
      ...publicRouteAliases,
      {
        source: "/:path*",
        has: [
          {
            type: "host",
            value: "www.maxitrouvaille.fr",
          },
        ],
        destination: "https://maxitrouvaille.fr/:path*",
        permanent: true,
      },
    ];
  },
  images: {
    remotePatterns: [
      {
        protocol: "https",
        hostname: "images.unsplash.com",
      },
      {
        protocol: "https",
        hostname: "ae01.alicdn.com",
      },
      {
        protocol: "https",
        hostname: "ae-pic-a1.aliexpress-media.com",
      },
    ],
  },
};

