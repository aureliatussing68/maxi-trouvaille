      <div className="container-page grid gap-8 py-10">
        <ServiceReadinessPanel metrics={metrics} />
        <PartnerProgramGatePanel />
        <CustomerJourneyPanel />

        <section className="rounded-lg border border-line bg-paper p-6 shadow-sm">
          <ClipboardList className="mb-4 text-teal" size={30} aria-hidden="true" />
          <h2 className="text-2xl font-black">Ancien dépôt remplacé</h2>
          <p className="mt-3 max-w-3xl text-sm leading-6 text-muted">
            Cette page garde l&apos;ancienne adresse mais ne lance aucun formulaire.
            Le futur parcours utilisera un compte professionnel, un statut de
            validation, des photos exactes, un prix, une categorie et une revue
            admin avant publication.
          </p>
          <div className="mt-6 grid gap-4 md:grid-cols-2">
            <div className="rounded-lg border border-dashed border-line p-4">
              <h3 className="font-black">Champs prevus</h3>
              <p className="mt-2 text-sm leading-6 text-muted">
                Titre, description, prix, etat, categorie, photos, stock,
                livraison et informations partenaire.
              </p>
            </div>
            <div className="rounded-lg border border-dashed border-line p-4">
              <h3 className="font-black">Workflow prevu</h3>
              <p className="mt-2 text-sm leading-6 text-muted">
                Sélection, attente de validation, approbation ou refus par un
                administrateur.
              </p>
            </div>
          </div>
        </section>
      </div>
    </>
  );
