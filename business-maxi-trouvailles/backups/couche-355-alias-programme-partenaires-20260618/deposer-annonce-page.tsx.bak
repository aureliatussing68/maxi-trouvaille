export const metadata: Metadata = {
  title: "Programme partenaires",
  description:
    "Ancien accès annonce remplacé par le programme partenaires Maxi Trouvaille en préparation.",
  robots: {
    index: false,
    follow: false,
  },
};

export default async function CreateListingPage() {
  const metrics = await getStorefrontControlMetrics();

  return (
    <>
      <PageHeader
        eyebrow="Programme partenaires"
