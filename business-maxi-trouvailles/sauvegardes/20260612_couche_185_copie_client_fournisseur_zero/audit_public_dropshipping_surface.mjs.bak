import fs from "node:fs";
import path from "node:path";

const root = process.cwd();
const catalogPath = path.join(root, "src", "lib", "catalog.ts");
const productCardPath = path.join(root, "src", "components", "ProductCard.tsx");
const quickProductsPath = path.join(root, "data", "quick-products.json");
const outputDir = path.join(
  root,
  "business-maxi-trouvailles",
  "tableaux-action",
  `surface-publique-dropshipping-${new Date().toISOString().slice(0, 10).replace(/-/g, "")}`,
);

const dropshippingFocusCategoryIds = new Set([
  "dropshipping",
  "dropshipping-nouveautes",
  "dropshipping-promotions",
  "dropshipping-maison",
  "dropshipping-cuisine",
  "dropshipping-beaute",
  "dropshipping-high-tech",
  "dropshipping-accessoires",
  "dropshipping-auto-moto",
  "dropshipping-animaux",
  "dropshipping-enfant",
  "dropshipping-mode",
]);

const surpriseCategoryIds = new Set([
  "colis-surprise-palettes",
  "palettes-destockage",
  "colis-mysteres",
  "colis-au-poids",
  "colis-surprise",
  "lots-bonnes-affaires",
]);

const publicSourceRelativePaths = [
  "src/app/page.tsx",
  "src/app/boutique/page.tsx",
  "src/app/categories/page.tsx",
  "src/app/categories/[slug]/page.tsx",
  "src/app/produit/[slug]/page.tsx",
  "src/app/panier/page.tsx",
  "src/app/paiement/succes/page.tsx",
  "src/app/paiement/annule/page.tsx",
  "src/app/faq/page.tsx",
  "src/app/livraison/page.tsx",
  "src/app/dropshipping/page.tsx",
  "src/app/produits-partenaires/page.tsx",
  "src/app/suivi-colis/page.tsx",
  "src/app/conditions-dropshipping/page.tsx",
  "src/app/conditions-produits-partenaires/page.tsx",
  "src/components/CartView.tsx",
  "src/components/CategoryGrid.tsx",
  "src/components/CheckoutView.tsx",
  "src/components/Footer.tsx",
  "src/components/Header.tsx",
  "src/components/HeroCarousel.tsx",
  "src/components/OrderSuccess.tsx",
  "src/components/ProductCard.tsx",
  "src/components/ProductMessageForm.tsx",
  "src/components/ShopProductExplorer.tsx",
  "src/components/TrackingLookupForm.tsx",
  "src/components/TrustBar.tsx",
];

const hardLeakPatterns = [
  { id: "aliexpress_visible", pattern: /aliexpress/i },
  { id: "supplier_url_key_visible", pattern: /supplierUrl/ },
  { id: "supplier_price_visible", pattern: /prix fournisseur/i },
  { id: "supplier_link_visible", pattern: /lien fournisseur/i },
  { id: "supplier_source_visible", pattern: /source fournisseur/i },
  { id: "findniche_visible", pattern: /findniche/i },
  { id: "pricearchive_visible", pattern: /pricearchive/i },
  { id: "raw_margin_visible", pattern: /marge (brute|cible)/i },
];

const softLeakPatterns = [
  { id: "supplier_word_public_copy", pattern: /fournisseur/i },
  { id: "internal_word_public_copy", pattern: /interne/i },
];

function readFile(filePath) {
  return fs.readFileSync(filePath, "utf8");
}

function readJson(filePath, fallback) {
  if (!fs.existsSync(filePath)) {
    return fallback;
  }

  return JSON.parse(readFile(filePath));
}

function normalizeText(value) {
  return String(value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
}

function hasHoldOrManualCheckSignal(value) {
  const normalized = normalizeText(value);

  return [
    "hold",
    "a verifier",
    "verifier avant",
    "a confirmer",
    "confirmer avant",
    "obligatoire",
    "manquant",
    "missing",
    "avant publication",
    "avant vente",
  ].some((signal) => normalized.includes(signal));
}

function hasExactSupplierUrl(value) {
  const normalized = normalizeText(value);

  if (!normalized) {
    return false;
  }

  return !(
    normalized.includes("wholesale?") ||
    normalized.includes("searchtext=") ||
    normalized.includes("/w/wholesale-")
  );
}

function hasReadyStatus(value) {
  const normalized = normalizeText(value);
  const statusParts = normalized.split(/[^a-z0-9]+/).filter(Boolean);

  if (
    !normalized ||
    hasHoldOrManualCheckSignal(normalized) ||
    ["not", "non", "pas", "pending", "ko", "incomplete", "blocked", "refused", "invalid"].some(
      (status) => statusParts.includes(status),
    )
  ) {
    return false;
  }

  return ["ok", "ready", "verified", "validated", "valide"].some((status) =>
    statusParts.includes(status),
  );
}

function findMatching(source, startIndex, openChar, closeChar) {
  let depth = 0;
  let quote = null;
  let escaped = false;
  let lineComment = false;
  let blockComment = false;

  for (let index = startIndex; index < source.length; index += 1) {
    const char = source[index];
    const next = source[index + 1];

    if (lineComment) {
      if (char === "\n") {
        lineComment = false;
      }
      continue;
    }

    if (blockComment) {
      if (char === "*" && next === "/") {
        blockComment = false;
        index += 1;
      }
      continue;
    }

    if (quote) {
      if (escaped) {
        escaped = false;
      } else if (char === "\\") {
        escaped = true;
      } else if (char === quote) {
        quote = null;
      }
      continue;
    }

    if (char === "/" && next === "/") {
      lineComment = true;
      index += 1;
      continue;
    }

    if (char === "/" && next === "*") {
      blockComment = true;
      index += 1;
      continue;
    }

    if (char === "\"" || char === "'" || char === "`") {
      quote = char;
      continue;
    }

    if (char === openChar) {
      depth += 1;
    } else if (char === closeChar) {
      depth -= 1;
      if (depth === 0) {
        return index;
      }
    }
  }

  throw new Error(`No matching ${closeChar} found.`);
}

function extractConstArray(source, marker) {
  const markerIndex = source.indexOf(marker);
  if (markerIndex === -1) {
    throw new Error(`Cannot find ${marker}.`);
  }

  const assignmentIndex = source.indexOf("=", markerIndex);
  const arrayStart = source.indexOf("[", assignmentIndex);
  const arrayEnd = findMatching(source, arrayStart, "[", "]");
  return source.slice(arrayStart + 1, arrayEnd);
}

function extractTopLevelObjects(arraySource) {
  const objects = [];
  let quote = null;
  let escaped = false;
  let depth = 0;
  let objectStart = -1;
  let lineComment = false;
  let blockComment = false;

  for (let index = 0; index < arraySource.length; index += 1) {
    const char = arraySource[index];
    const next = arraySource[index + 1];

    if (lineComment) {
      if (char === "\n") {
        lineComment = false;
      }
      continue;
    }

    if (blockComment) {
      if (char === "*" && next === "/") {
        blockComment = false;
        index += 1;
      }
      continue;
    }

    if (quote) {
      if (escaped) {
        escaped = false;
      } else if (char === "\\") {
        escaped = true;
      } else if (char === quote) {
        quote = null;
      }
      continue;
    }

    if (char === "/" && next === "/") {
      lineComment = true;
      index += 1;
      continue;
    }

    if (char === "/" && next === "*") {
      blockComment = true;
      index += 1;
      continue;
    }

    if (char === "\"" || char === "'" || char === "`") {
      quote = char;
      continue;
    }

    if (char === "{") {
      if (depth === 0) {
        objectStart = index;
      }
      depth += 1;
    } else if (char === "}") {
      depth -= 1;
      if (depth === 0 && objectStart !== -1) {
        objects.push(arraySource.slice(objectStart, index + 1));
        objectStart = -1;
      }
    }
  }

  return objects;
}

function stringProp(block, prop) {
  const match = block.match(new RegExp(`${prop}:\\s*["'\`]([^"'\`]+)["'\`]`, "s"));
  return match?.[1] ?? "";
}

function numberProp(block, prop) {
  const match = block.match(new RegExp(`${prop}:\\s*(\\d+)`));
  return match ? Number(match[1]) : 0;
}

function booleanProp(block, prop) {
  const match = block.match(new RegExp(`${prop}:\\s*(true|false)`));
  return match ? match[1] === "true" : false;
}

function nestedBlock(block, prop) {
  const marker = `${prop}:`;
  const markerIndex = block.indexOf(marker);
  if (markerIndex === -1) {
    return "";
  }

  const objectStart = block.indexOf("{", markerIndex);
  if (objectStart === -1) {
    return "";
  }

  const objectEnd = findMatching(block, objectStart, "{", "}");
  return block.slice(objectStart, objectEnd + 1);
}

function arrayStringsProp(block, prop) {
  const marker = `${prop}:`;
  const markerIndex = block.indexOf(marker);
  if (markerIndex === -1) {
    return [];
  }

  const arrayStart = block.indexOf("[", markerIndex);
  if (arrayStart === -1) {
    return [];
  }

  const arrayEnd = findMatching(block, arrayStart, "[", "]");
  const arrayBlock = block.slice(arrayStart, arrayEnd + 1);
  return [...arrayBlock.matchAll(/["'`]([^"'`]+)["'`]/g)].map((match) => match[1]);
}

function hasNestedDropshippingEnabled(block) {
  return /dropshipping:\s*{[\s\S]*?enabled:\s*true/.test(block);
}

function staticProductsFromCatalog() {
  const source = readFile(catalogPath);
  const arraySource = extractConstArray(source, "export const products");
  const blocks = extractTopLevelObjects(arraySource);

  return blocks.map((block) => {
    const dropshippingBlock = nestedBlock(block, "dropshipping");
    const validationGateBlock = nestedBlock(dropshippingBlock, "validationGate");
    const imageValidationBlock = nestedBlock(block, "imageValidation");
    const sourceVerificationBlock = nestedBlock(block, "sourceVerification");
    const internalSourcingBlock = nestedBlock(block, "internalSourcing");
    return {
      origin: "src/lib/catalog.ts",
      id: stringProp(block, "id"),
      slug: stringProp(block, "slug"),
      name: stringProp(block, "name"),
      categoryId: stringProp(block, "categoryId"),
      status: stringProp(block, "status") || "published",
      commerceStatus: stringProp(block, "commerceStatus"),
      condition: stringProp(block, "condition"),
      badge: stringProp(block, "badge"),
      image: stringProp(block, "image"),
      images: arrayStringsProp(block, "images"),
      shortDescription: stringProp(block, "shortDescription"),
      description: stringProp(block, "description"),
      features: arrayStringsProp(block, "features"),
      stock: numberProp(block, "stock"),
      source: stringProp(block, "source"),
      isTestProduct: booleanProp(block, "isTestProduct"),
      dropshippingEnabled: hasNestedDropshippingEnabled(block),
      supplierUrl: stringProp(dropshippingBlock, "supplierUrl"),
      supplierSku: stringProp(dropshippingBlock, "supplierSku"),
      supplierPriceCents: numberProp(dropshippingBlock, "supplierPriceCents"),
      salePriceCents: numberProp(dropshippingBlock, "salePriceCents"),
      marginCents: numberProp(dropshippingBlock, "marginCents"),
      supplierStock: numberProp(dropshippingBlock, "supplierStock"),
      deliveryEstimate: stringProp(dropshippingBlock, "deliveryEstimate"),
      validationGateNote: stringProp(validationGateBlock, "note"),
      validationGateChecks: arrayStringsProp(validationGateBlock, "checks"),
      imageValidationStatus: stringProp(imageValidationBlock, "status"),
      sourceDeliveryStatus: stringProp(sourceVerificationBlock, "deliveryStatus"),
      sourcePriceStatus: stringProp(sourceVerificationBlock, "priceStatus"),
      sourceRightsStatus: stringProp(sourceVerificationBlock, "rightsStatus"),
      internalValidationStatus: stringProp(internalSourcingBlock, "validationStatus"),
    };
  });
}

function quickProductsFromData() {
  const products = readJson(quickProductsPath, []);
  if (!Array.isArray(products)) {
    throw new Error("data/quick-products.json must contain an array.");
  }

  return products.map((product) => ({
    origin: "data/quick-products.json",
    id: product.id,
    slug: product.slug,
    name: product.name,
    categoryId: product.categoryId,
    status: product.status ?? "published",
    commerceStatus: product.commerceStatus ?? "",
    condition: product.condition ?? "",
    badge: product.badge ?? "",
    image: product.image ?? "",
    images: Array.isArray(product.images) ? product.images : [],
    shortDescription: product.shortDescription ?? "",
    description: product.description ?? "",
    features: Array.isArray(product.features) ? product.features : [],
    stock: Number(product.stock ?? 0),
    source: product.source ?? "",
    isTestProduct: Boolean(product.isTestProduct),
    dropshippingEnabled: Boolean(product.dropshipping?.enabled),
    supplierUrl: product.dropshipping?.supplierUrl ?? "",
    supplierSku: product.dropshipping?.supplierSku ?? "",
    supplierPriceCents: Number(product.dropshipping?.supplierPriceCents ?? 0),
    salePriceCents: Number(product.dropshipping?.salePriceCents ?? 0),
    marginCents: Number(product.dropshipping?.marginCents ?? 0),
    supplierStock: Number(product.dropshipping?.supplierStock ?? 0),
    deliveryEstimate: product.dropshipping?.deliveryEstimate ?? "",
    validationGateNote: product.dropshipping?.validationGate?.note ?? "",
    validationGateChecks: Array.isArray(product.dropshipping?.validationGate?.checks)
      ? product.dropshipping.validationGate.checks
      : [],
    imageValidationStatus: product.imageValidation?.status ?? "",
    sourceDeliveryStatus: product.sourceVerification?.deliveryStatus ?? "",
    sourcePriceStatus: product.sourceVerification?.priceStatus ?? "",
    sourceRightsStatus: product.sourceVerification?.rightsStatus ?? "",
    internalValidationStatus: product.internalSourcing?.validationStatus ?? "",
  }));
}

function isComingSoon(product) {
  if (product.commerceStatus === "coming-soon") {
    return true;
  }

  if (surpriseCategoryIds.has(product.categoryId)) {
    return true;
  }

  const text = normalizeText(
    [product.name, product.shortDescription, product.description].join(" "),
  );

  return [
    "palette surprise",
    "palette mystere",
    "colis surprise",
    "colis mystere",
    "box mystere",
    "mystery box",
    "colis perdu",
  ].some((keyword) => text.includes(normalizeText(keyword)));
}

function publicReadinessBlockers(product) {
  const blockers = [];

  if (!product.dropshippingEnabled) {
    blockers.push("dropshipping_disabled");
    return blockers;
  }

  if (!hasExactSupplierUrl(product.supplierUrl)) {
    blockers.push("supplier_url_exact_missing");
  }

  if (!product.supplierSku) {
    blockers.push("supplier_sku_missing");
  }

  if (!(product.supplierPriceCents > 0)) {
    blockers.push("supplier_price_missing");
  }

  if (!(product.salePriceCents > 0)) {
    blockers.push("sale_price_missing");
  }

  if (!(product.marginCents > 0)) {
    blockers.push("margin_missing");
  }

  if (!(product.supplierStock > 0)) {
    blockers.push("supplier_stock_missing");
  }

  if (!product.deliveryEstimate || hasHoldOrManualCheckSignal(product.deliveryEstimate)) {
    blockers.push("delivery_estimate_not_ready");
  }

  if (product.imageValidationStatus !== "verified_source_images") {
    blockers.push("exact_images_not_verified");
  }

  blockers.push(...publicImageBlockers(product));

  if (!product.sourceRightsStatus || !hasReadyStatus(product.sourceRightsStatus)) {
    blockers.push("image_rights_not_ready");
  }

  if (!product.sourcePriceStatus || !hasReadyStatus(product.sourcePriceStatus)) {
    blockers.push("source_price_not_ready");
  }

  if (!product.sourceDeliveryStatus || !hasReadyStatus(product.sourceDeliveryStatus)) {
    blockers.push("source_delivery_not_ready");
  }

  if (!product.validationGateNote && product.validationGateChecks.length === 0) {
    blockers.push("validation_gate_missing");
  }

  if (
    hasHoldOrManualCheckSignal(product.validationGateNote) ||
    hasHoldOrManualCheckSignal(product.validationGateChecks.join(" "))
  ) {
    blockers.push("validation_gate_not_ready");
  }

  if (hasHoldOrManualCheckSignal(product.internalValidationStatus)) {
    blockers.push("internal_sourcing_hold");
  }

  if (isComingSoon(product)) {
    blockers.push("coming_soon");
  }

  return Array.from(new Set(blockers));
}

function productImageCandidates(product) {
  return Array.from(
    new Set(
      [product.image, ...(Array.isArray(product.images) ? product.images : [])]
        .map((image) => String(image ?? "").trim())
        .filter(Boolean),
    ),
  );
}

function safeImageLabel(image) {
  const value = String(image ?? "");

  if (/^https?:\/\//i.test(value)) {
    return "[image distante masquee]";
  }

  return value;
}

function publicImageBlockers(product) {
  const blockers = [];
  const images = productImageCandidates(product);

  if (images.length === 0) {
    blockers.push("image_missing");
  }

  for (const image of images) {
    if (/^https?:\/\//i.test(image)) {
      blockers.push("image_remote_not_local");
    }

    if (/aliexpress|alicdn|ae-pic|temu/i.test(image)) {
      blockers.push("supplier_cdn_image");
    }

    if (/images\.unsplash\.com|unsplash/i.test(image)) {
      blockers.push("stock_visual_image");
    }

    if (image.startsWith("/uploads/category-images/") || image.startsWith("/uploads/generated-products/")) {
      blockers.push("image_not_exact_product_photo");
    }

    if (/placeholder|hold|a-verifier/i.test(image)) {
      blockers.push("placeholder_or_hold_image");
    }

    if (!image.startsWith("/uploads/partner-products/") && !image.startsWith("/uploads/quick-products/")) {
      blockers.push("image_not_in_exact_product_depot");
    }

    if (!/\.webp(?:\?.*)?$/i.test(image)) {
      blockers.push("image_not_webp");
    }
  }

  return Array.from(new Set(blockers));
}

function isPublicDropshippingProduct(product) {
  return (
    (product.status ?? "published") === "published" &&
    !product.isTestProduct &&
    dropshippingFocusCategoryIds.has(product.categoryId) &&
    publicReadinessBlockers(product).length === 0
  );
}

function isPurchasableDropshippingProduct(product) {
  return isPublicDropshippingProduct(product) && product.stock > 0 && !isComingSoon(product);
}

function publicText(product) {
  return [
    product.name,
    product.badge,
    product.condition,
    product.shortDescription,
    product.description,
    ...product.features,
  ].join("\n");
}

function leakMatches(text, patterns) {
  return patterns
    .filter((entry) => entry.pattern.test(text))
    .map((entry) => entry.id);
}

function imageRiskReasons(product) {
  const reasons = [];
  const image = String(product.image ?? "");
  reasons.push(...publicImageBlockers(product));

  if (!image) {
    reasons.push("image_missing");
  }

  if (/^https?:\/\//i.test(image)) {
    reasons.push("external_public_image");
  }

  if (/aliexpress|alicdn|ae-pic|alicdn/i.test(image)) {
    reasons.push("supplier_cdn_image");
  }

  if (/images\.unsplash\.com/i.test(image)) {
    reasons.push("unsplash_generic_image");
  }

  if (image.includes("/uploads/generated-products/")) {
    reasons.push("generated_product_image_not_exact_proof");
  }

  if (/placeholder/i.test(image)) {
    reasons.push("placeholder_image");
  }

  if (image && !image.startsWith("/uploads/partner-products/")) {
    reasons.push("not_partner_products_local_path");
  }

  if (/hold/i.test(product.validationGateNote)) {
    reasons.push("validation_gate_still_hold");
  }

  return Array.from(new Set(reasons));
}

function auditProducts(products) {
  return products.map((product) => {
    const visible = isPublicDropshippingProduct(product);
    const purchasable = isPurchasableDropshippingProduct(product);
    const text = publicText(product);
    const hardTextLeaks = visible ? leakMatches(text, hardLeakPatterns) : [];
    const softTextWarnings = visible ? leakMatches(text, softLeakPatterns) : [];
    const hardImageRisks = visible ? imageRiskReasons(product) : [];
    const publicationBlockers =
      product.dropshippingEnabled && dropshippingFocusCategoryIds.has(product.categoryId)
        ? publicReadinessBlockers(product)
        : [];

    return {
      id: product.id,
      slug: product.slug,
      name: product.name,
      origin: product.origin,
      categoryId: product.categoryId,
      status: product.status,
      visible,
      purchasable,
      image: safeImageLabel(product.image),
      hardTextLeaks,
      softTextWarnings,
      hardImageRisks,
      publicationBlockers,
    };
  });
}

function auditPublicSources() {
  const findings = [];
  const warnings = [];

  for (const relativePath of publicSourceRelativePaths) {
    const filePath = path.join(root, relativePath);
    if (!fs.existsSync(filePath)) {
      continue;
    }

    const source = readFile(filePath);
    const lines = source.split(/\r?\n/);

    lines.forEach((line, index) => {
      const hardMatches = leakMatches(line, hardLeakPatterns);
      const softMatches = leakMatches(line, softLeakPatterns);

      hardMatches.forEach((match) => {
        findings.push({
          file: relativePath,
          line: index + 1,
          type: match,
          text: line.trim(),
        });
      });

      softMatches.forEach((match) => {
        warnings.push({
          file: relativePath,
          line: index + 1,
          type: match,
          text: line.trim(),
        });
      });
    });
  }

  return { findings, warnings };
}

function countBy(items, getKey) {
  return items.reduce((acc, item) => {
    const key = getKey(item);
    acc[key] = (acc[key] ?? 0) + 1;
    return acc;
  }, {});
}

function markdownReport(summary) {
  const lines = [
    "# Audit surface publique dropshipping",
    "",
    `Date: ${summary.checkedAt}`,
    `Statut: ${summary.ok ? "OK" : "ECHEC"}`,
    "",
    "## Resume",
    "",
    `- Produits analyses: ${summary.productCount}`,
    `- Produits visibles storefront dropshipping: ${summary.visibleDropshippingCount}`,
    `- Produits achetables storefront dropshipping: ${summary.purchasableDropshippingCount}`,
    `- Fuites texte/image bloquantes: ${summary.failureCount}`,
    `- Avertissements wording public: ${summary.warningCount}`,
    `- Brouillons dropshipping avec bloqueurs publication: ${summary.draftBlockedCount}`,
    `- Fiches publiees bloquees par readiness: ${summary.publishedReadinessFailureCount}`,
    "",
    "## Bloquants publics",
    "",
    ...(summary.failures.length
      ? summary.failures.map(
          (failure) =>
            `- ${failure.scope} ${failure.id ?? failure.file}:${failure.line ?? ""} - ${failure.reason}`,
        )
      : ["- Aucun"]),
    "",
    "## Brouillons dropshipping a garder en HOLD",
    "",
    ...(summary.draftBlockedProducts.length
      ? summary.draftBlockedProducts.map(
          (product) =>
            `- ${product.name} (${product.id}) - ${product.publicationBlockers.join(", ")}`,
        )
      : ["- Aucun"]),
    "",
    "## Warnings wording public",
    "",
    ...(summary.warnings.length
      ? summary.warnings
          .slice(0, 25)
          .map((warning) => `- ${warning.file}:${warning.line} - ${warning.type}`)
      : ["- Aucun"]),
    "",
    "## Garde-fous",
    "",
    ...Object.entries(summary.safety).map(([key, value]) => `- ${key}: ${value}`),
    "",
  ];

  return `${lines.join("\n")}\n`;
}

const allProducts = [...staticProductsFromCatalog(), ...quickProductsFromData()];
const productAudits = auditProducts(allProducts);
const publicSourceAudit = auditPublicSources();
const catalogSource = readFile(catalogPath);
const productCardSource = readFile(productCardPath);

const productFailures = productAudits.flatMap((product) => [
  ...product.hardTextLeaks.map((reason) => ({
    scope: "product_text",
    id: product.id,
    reason,
  })),
  ...product.hardImageRisks.map((reason) => ({
    scope: "product_image",
    id: product.id,
    reason,
  })),
]);
const publishedReadinessFailures = productAudits
  .filter(
    (product) =>
      product.status === "published" &&
      product.dropshippingEnabled &&
      dropshippingFocusCategoryIds.has(product.categoryId) &&
      product.publicationBlockers.length > 0,
  )
  .map((product) => ({
    scope: "public_readiness_gate",
    id: product.id,
    reason: product.publicationBlockers.join(", "),
  }));
const catalogGateFailures = [
  {
    needle: "isDropshippingProductReadyForPublic(product)",
    reason: "catalog_public_readiness_gate_missing",
  },
  {
    needle: "getDropshippingPublicBlockers(product)",
    reason: "catalog_public_blocker_helper_missing",
  },
  {
    needle: "getPublicImageBlockers(product)",
    reason: "catalog_public_image_blocker_helper_missing",
  },
].flatMap((check) =>
  catalogSource.includes(check.needle)
    ? []
    : [
        {
          scope: "catalog_source",
          file: "src/lib/catalog.ts",
          reason: check.reason,
        },
      ],
);
const productCardGuardFailures = [
  {
    ok: productCardSource.includes("isPublicProduct(product)"),
    reason: "product_card_public_gate_missing",
  },
  {
    ok: productCardSource.includes("canRenderPublicProduct"),
    reason: "product_card_render_gate_missing",
  },
  {
    ok:
      productCardSource.includes("Fiche en validation") &&
      productCardSource.includes("Produit en contrôle qualité"),
    reason: "product_card_hold_placeholder_missing",
  },
].flatMap((check) =>
  check.ok
    ? []
    : [
        {
          scope: "public_source_guard",
          file: "src/components/ProductCard.tsx",
          reason: check.reason,
        },
      ],
);

const sourceFailures = publicSourceAudit.findings.map((finding) => ({
  scope: "public_source",
  file: finding.file,
  line: finding.line,
  reason: finding.type,
  text: finding.text,
}));

const failures = [
  ...productFailures,
  ...publishedReadinessFailures,
  ...catalogGateFailures,
  ...productCardGuardFailures,
  ...sourceFailures,
];
const draftBlockedProducts = productAudits.filter(
  (product) =>
    product.status !== "published" &&
    product.publicationBlockers.length > 0 &&
    dropshippingFocusCategoryIds.has(product.categoryId),
);

const checkedAt = new Date().toISOString();
const dateKey = checkedAt.slice(0, 10).replace(/-/g, "");
const summary = {
  ok: failures.length === 0,
  checkedAt,
  mode: "read_only_public_dropshipping_surface_audit",
  productCount: allProducts.length,
  visibleDropshippingCount: productAudits.filter((product) => product.visible).length,
  purchasableDropshippingCount: productAudits.filter((product) => product.purchasable)
    .length,
  failureCount: failures.length,
  warningCount: publicSourceAudit.warnings.length,
  draftBlockedCount: draftBlockedProducts.length,
  publishedReadinessFailureCount: publishedReadinessFailures.length,
  failures,
  warnings: publicSourceAudit.warnings,
  draftBlockedProducts,
  byStatus: countBy(productAudits, (product) => product.status ?? "published"),
  byCategory: countBy(productAudits, (product) => product.categoryId ?? "sans_categorie"),
  productAudits,
  safety: {
    readOnlyAudit: true,
    noCatalogWrite: true,
    noPublication: true,
    noPayment: true,
    noSupplierOrder: true,
    noMessageSent: true,
  },
};

fs.mkdirSync(outputDir, { recursive: true });
const jsonPath = path.join(outputDir, `AUDIT_SURFACE_PUBLIQUE_DROPSHIPPING_${dateKey}.json`);
const mdPath = path.join(outputDir, `AUDIT_SURFACE_PUBLIQUE_DROPSHIPPING_${dateKey}.md`);
fs.writeFileSync(jsonPath, `${JSON.stringify(summary, null, 2)}\n`, "utf8");
fs.writeFileSync(mdPath, markdownReport(summary), "utf8");

console.log(
  JSON.stringify(
    {
      ok: summary.ok,
      mode: summary.mode,
      visibleDropshippingCount: summary.visibleDropshippingCount,
      purchasableDropshippingCount: summary.purchasableDropshippingCount,
      failureCount: summary.failureCount,
      warningCount: summary.warningCount,
      draftBlockedCount: summary.draftBlockedCount,
      publishedReadinessFailureCount: summary.publishedReadinessFailureCount,
      files: { jsonPath, mdPath },
      safety: summary.safety,
    },
    null,
    2,
  ),
);

if (!summary.ok) {
  process.exitCode = 1;
}
