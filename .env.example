# Copiez ce fichier vers .env.local pour tester Stripe en local.
# Ne mettez jamais de cle secrete Stripe dans le code source.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_remplacez_moi
STRIPE_SECRET_KEY=sk_test_remplacez_moi
STRIPE_ENABLE_LIVE_PAYMENTS=false
ADMIN_MODE=true

# Stats vues/favoris. En local, sans base, un JSON temporaire non versionne
# est utilise. En production Vercel, ajoutez une vraie base Postgres.
# PRODUCT_STATS_DATABASE_URL=postgres://...
# ou DATABASE_URL=postgres://...
# ou POSTGRES_URL=postgres://...

# Avis clients apres achat. Par defaut, ils utilisent la meme base Postgres.
# PRODUCT_REVIEWS_DATABASE_URL=postgres://...

# Messages envoyes depuis les fiches produits. Par defaut, ils utilisent la
# meme base Postgres que les stats si elle existe.
# PRODUCT_MESSAGES_DATABASE_URL=postgres://...

# A utiliser plus tard pour valider les evenements Stripe cote serveur.
STRIPE_WEBHOOK_SECRET=whsec_remplacez_moi_plus_tard

# Dropshipping : espaces de connexion prets a remplir, sans faux identifiants.
# ALIEXPRESS_API_KEY=
# ALIEXPRESS_API_SECRET=
# ALIEXPRESS_TRACKING_ID=
# DSERS_API_KEY=
# AUTODS_API_KEY=
# DROPSHIPPING_DEFAULT_MARGIN_PERCENT=35
# DROPSHIPPING_DEFAULT_FIXED_MARGIN=3.00
