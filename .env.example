# Copiez ce fichier vers .env.local pour tester Stripe en local.
# Ne mettez jamais de cle secrete Stripe dans le code source.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_remplacez_moi
STRIPE_SECRET_KEY=sk_test_remplacez_moi
STRIPE_ENABLE_LIVE_PAYMENTS=false
ADMIN_MODE=true

# Stats vues/favoris. En local, sans base, un JSON temporaire non versionne
# est utilise. En production Vercel, ajoutez une vraie base Postgres.
# PRODUCT_STATS_DATABASE_URL=postgres://...
# ou DATABASE_URL=postgres://...
# ou POSTGRES_URL=postgres://...

# Avis clients apres achat. Par defaut, ils utilisent la meme base Postgres.
# PRODUCT_REVIEWS_DATABASE_URL=postgres://...

# Messages envoyes depuis les fiches produits. Par defaut, ils utilisent la
# meme base Postgres que les stats si elle existe.
# PRODUCT_MESSAGES_DATABASE_URL=postgres://...

# A utiliser plus tard pour valider les evenements Stripe cote serveur.
STRIPE_WEBHOOK_SECRET=whsec_remplacez_moi_plus_tard

# Emails automatiques (confirmation de commande, expedition, reponse client).
# Fournisseur : Resend (https://resend.com), appele en HTTP direct, aucune
# librairie npm a installer.
# TANT QUE RESEND_API_KEY EST ABSENTE OU COMMENTEE, LE SITE N'ENVOIE AUCUN
# EMAIL ET SE COMPORTE EXACTEMENT COMME AVANT.
# RESEND_API_KEY=re_remplacez_moi
# EMAIL_FROM=Maxi Trouvaille <commandes@maxitrouvaille.fr>
# EMAIL_REPLY_TO=contact@maxitrouvaille.fr
# Interrupteur d'arret d'urgence : mettre false coupe tous les envois
# meme si la cle est presente.
# MAXI_EMAILS_ENABLED=true
# Code d'acces de la page de test /api/emails/test (404 tant qu'il est absent).
# MAXI_EMAIL_TEST_TOKEN=remplacez_moi_par_un_code_secret

# Dropshipping : espaces de connexion prets a remplir, sans faux identifiants.
# ALIEXPRESS_API_KEY=
# ALIEXPRESS_API_SECRET=
# ALIEXPRESS_TRACKING_ID=
# DSERS_API_KEY=
# AUTODS_API_KEY=
# DROPSHIPPING_DEFAULT_MARGIN_PERCENT=35
# DROPSHIPPING_DEFAULT_FIXED_MARGIN=3.00

# Service client assiste (classement des messages + brouillon de reponse).
# Rien ne s'active tant que la premiere ligne est commentee.
# MAXI_SUPPORT_AI_ENABLED=true
# Mode d'envoi : "brouillon" (defaut, recommande) ou "auto".
# MAXI_SUPPORT_AI_MODE=brouillon
# Cle API Claude. Absente = repli gratuit sur les modeles pre-ecrits.
# ANTHROPIC_API_KEY=sk-ant-remplacez_moi
# Modele utilise (defaut : claude-haiku-4-5).
# MAXI_SUPPORT_AI_MODEL=claude-haiku-4-5
# Plafond d'appels IA par jour et par instance (defaut : 50).
# MAXI_SUPPORT_AI_MAX_PER_DAY=50

# --- Connecteur CJ Dropshipping (commande fournisseur automatique) ---
# Cle API du compte CJ : Personal Center -> API -> Add API. SENSIBLE.
CJ_API_KEY=remplacez_moi
# "true" pour activer la commande automatique au webhook Stripe.
CJ_ENABLED=false
# "true" = payer immediatement depuis le solde prepaye CJ (payType 2).
# false = creer la commande seulement, paiement du solde a la main (payType 3).
CJ_AUTOPAY=false
# Transporteur CJ par defaut — a confirmer a la premiere commande de test.
CJ_DEFAULT_LOGISTIC=CJPacket Ordinary
# Entrepot d'origine (code pays 2 lettres).
CJ_FROM_COUNTRY=CN
# "1" = mode bac a sable CJ (test de bout en bout sans depenser).
CJ_SANDBOX=0
# Secret que Vercel ajoute a ses crons (Authorization: Bearer ...) pour
# proteger /api/cron/cj-sync. Chaine longue aleatoire, a poser dans Vercel.
CRON_SECRET=
