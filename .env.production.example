# Exemple de variables a definir chez l'hebergeur de production.
# Ne jamais commiter de fichier .env.production contenant de vraies cles.

NEXT_PUBLIC_SITE_URL=https://maxitrouvaille.fr

# Stripe reste volontairement en mode test pour le moment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_remplacez_moi
STRIPE_SECRET_KEY=sk_test_remplacez_moi
STRIPE_ENABLE_LIVE_PAYMENTS=false

# A renseigner plus tard quand le webhook Stripe sera active.
STRIPE_WEBHOOK_SECRET=whsec_remplacez_moi_plus_tard

# Pour la premiere mise en ligne publique, garder l'admin cache.
# Remettre true seulement sur une version protegee par authentification.
ADMIN_MODE=false

# Base de donnees pour les vues/favoris reels en production.
# Recommande : Postgres fourni par Vercel/Neon/Supabase.
# Une seule de ces variables suffit, selon le fournisseur :
# PRODUCT_STATS_DATABASE_URL=postgres://...
# PRODUCT_REVIEWS_DATABASE_URL=postgres://...
# PRODUCT_MESSAGES_DATABASE_URL=postgres://...
# DATABASE_URL=postgres://...
# POSTGRES_URL=postgres://...

# Plus tard, quand tu valideras le passage en paiement reel :
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_ENABLE_LIVE_PAYMENTS=true

# Emails automatiques (Resend). A ajouter dans Vercel > Settings >
# Environment Variables, puis redeployer.
# Tant que RESEND_API_KEY est absente, aucun email n'est envoye et le site
# fonctionne exactement comme aujourd'hui.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Maxi Trouvaille <commandes@maxitrouvaille.fr>
# EMAIL_REPLY_TO=contact@maxitrouvaille.fr
# MAXI_EMAILS_ENABLED=true
# MAXI_EMAIL_TEST_TOKEN=code_secret_pour_la_page_de_test

# Dropshipping : renseigner uniquement apres creation des vrais comptes.
# ALIEXPRESS_API_KEY=
# ALIEXPRESS_API_SECRET=
# ALIEXPRESS_TRACKING_ID=
# DSERS_API_KEY=
# AUTODS_API_KEY=
# DROPSHIPPING_DEFAULT_MARGIN_PERCENT=35
# DROPSHIPPING_DEFAULT_FIXED_MARGIN=3.00

# Service client assiste. A activer seulement quand la base Postgres est
# branchee, sinon les brouillons partent dans un fichier temporaire efface
# a chaque deploiement.
# MAXI_SUPPORT_AI_ENABLED=true
# Garder "brouillon" au demarrage : aucune reponse ne part sans validation.
# MAXI_SUPPORT_AI_MODE=brouillon
# ANTHROPIC_API_KEY=sk-ant-remplacez_moi
# MAXI_SUPPORT_AI_MODEL=claude-haiku-4-5
# MAXI_SUPPORT_AI_MAX_PER_DAY=50
