                    <span className="text-xs font-black uppercase text-muted">
                      {item.batchLabel}
                    </span>
                  </div>
                  <h3 className="mt-2 text-xl font-black">{item.categoryName}</h3>
                  <p className="mt-2 text-sm leading-6 text-muted">
